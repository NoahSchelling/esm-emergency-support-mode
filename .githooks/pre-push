#!/usr/bin/env bash
# Git pre-push hook: scan what is about to be pushed (commits, their messages
# and authors, annotated tags, branch and tag names).
# Enabled with: git config core.hooksPath .githooks
# (the Claude Code SessionStart hook runs this automatically).
#
# Git passes the remote name and URL as arguments and
# "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
# Commits already on the destination are excluded using only what is known
# about that destination: its remote-tracking refs and the remote sha of each
# pushed ref. Refs of other remotes are not trusted (a fork may hold commits
# that were never scanned, and refs/remotes/* can be written locally).

root=$(git rev-parse --show-toplevel) || exit 2
remote="${1:-}"

tips=()
args=()
zero_re='^0+$'
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_sha:-}" ]] && continue
  # A deleted remote ref has an all-zero local sha; nothing to scan.
  [[ "$local_sha" =~ $zero_re ]] && continue
  tips+=("$local_sha")
  args+=(--ref "$local_ref" --ref "$remote_ref")
  if [[ -n "${remote_sha:-}" && ! "$remote_sha" =~ $zero_re ]] &&
    git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    args+=(--base "$remote_sha")
  fi
done

if ((${#tips[@]} == 0)); then
  echo "check-secrets: プッシュするコミットがないため検査を省略しました（参照の削除のみ）" >&2
  exit 0
fi

# A named remote: trust its remote-tracking refs. A bare URL: trust nothing
# but the remote shas above.
if [[ -n "$remote" ]] && git config --get "remote.$remote.url" >/dev/null 2>&1; then
  args=(--remote "$remote" "${args[@]}")
else
  args=(--no-remotes "${args[@]}")
fi

exec bash "$root/scripts/check-secrets.sh" --push "${args[@]}" "${tips[@]}"
