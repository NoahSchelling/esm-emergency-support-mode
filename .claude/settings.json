{
  "permissions": {
    "deny": [
      "Bash(git commit --no-verify:*)",
      "Bash(git push --no-verify:*)",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/claude-hook-bash.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" config core.hooksPath .githooks"
          }
        ]
      }
    ]
  }
}
